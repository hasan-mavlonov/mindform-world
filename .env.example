# MindForm World settings -- copy to .env (git-ignored). Everything here is optional.

# Where your MindForm v0 checkout lives (default: a sibling folder named mindform_v0).
# MINDFORM_V0_PATH=/Users/you/PycharmProjects/mindform_v0

# The Python that runs v0 (default: v0's own .venv if it has one, else this repo's Python).
# MINDFORM_V0_PYTHON=/Users/you/PycharmProjects/mindform_v0/.venv/bin/python

# The world's own LLM: planner, narrator, director. If you set nothing here, the key and
# model in MindForm v0's .env are used. Any OpenAI-compatible endpoint works.
# GEMINI_API_KEY=
# WORLD_LLM_API_KEY=          # a separate key/provider just for the world
# WORLD_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# WORLD_LLM_MODEL=gemini-3.5-flash

# Where worlds are saved (default: ./data).
# MINDFORM_WORLD_DATA=./data
